# Copy to .env and adjust. All data and outputs live OUTSIDE the repository.

# Derived data: per-tile statistics cache, boundary files.
TN_DATA_DIR=/path/to/tessera-nordic/data

# Run outputs: ${TN_OUTPUT_DIR}/<run_name>/<timestamp>/
TN_OUTPUT_DIR=/path/to/tessera-nordic/outputs

# Raw TESSERA downloads (NPY tiles) or the Zarr chunk cache (keep_raw: true).
TESSERA_DATA_DIR=/path/to/tessera-nordic/tessera
